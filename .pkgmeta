# BigWigs packager config (https://github.com/BigWigsMods/packager).
#
# Layout: the repo root is NOT the addon folder; the addon lives in AnotherHUD/.
# The packager must run from the repo root (it needs the git checkout there,
# see .gitlab-ci.yml) and copies it into .release/AnotherHUD/. move-folders
# then makes the inner AnotherHUD/ folder (the .toc and the code) the one
# addon folder of the zip; the externals land in its Libs/.
package-as: AnotherHUD

# Release notes for CurseForge: the hand-written CHANGELOG.md (newest version
# on top) instead of a list of commit messages. Keep each entry short (see
# docs/CHECKLIST.md, release steps).
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  AnotherHUD/AnotherHUD: AnotherHUD

# Libraries loaded by embeds.xml. LibEditMode is pinned to tag 19 (MINOR 19, the
# copy the code was written against); raise it on purpose. A development copy without Libs/ still
# works (everything but the Edit Mode part).
externals:
  AnotherHUD/Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  AnotherHUD/Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  AnotherHUD/Libs/LibEditMode:
    url: https://github.com/p3lim-wow/LibEditMode
    tag: "19"

# Repo files that are not part of the addon.
ignore:
  - CLAUDE.md
  - docs
  - tests
  - tools
  - .gitlab-ci.yml
